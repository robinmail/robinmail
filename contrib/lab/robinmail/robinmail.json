{
  "hostname": "mx.robin.test",
  "data_dir": "/var/lib/robinmail",
  "master_key_file": "/lab/secrets/master.key",
  "tls": {
    "cert_file": "/lab/secrets/mx.robin.test.crt",
    "key_file": "/lab/secrets/mx.robin.test.key"
  },
  "smtp": {
    "listen": ":25",
    "max_message_bytes": 2097152,
    "max_connections": 1000,
    "max_connections_per_ip": 1000
  },
  "web": {
    "listen": ":443"
  },
  "submission": {
    "listen": ":587",
    "listen_tls": ":465",
    "max_recipients_per_hour": 100000,
    "undo_seconds": 0
  },
  "imap": {
    "listen_tls": ":993",
    "listen": ":143",
    "max_connections": 2000,
    "max_connections_per_ip": 1000,
    "max_connections_per_user": 1000
  },
  "outbound": {
    "allow_private_addresses": true
  },
  "dev": {
    "retry_seconds": 5,
    "smtp_trace": true,
    "imap_trace": true
  }
}
