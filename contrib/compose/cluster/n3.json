{
  "hostname": "mail.robinmail.test",
  "data_dir": "/var/lib/robinmail",
  "master_key_file": "/etc/robinmail/secrets/master.key",
  "rqlite": {
    "urls": ["http://rqlite-3:4001", "http://rqlite-1:4001", "http://rqlite-2:4001"]
  },
  "node": {
    "id": "n3",
    "listen": ":7443",
    "address": "robinmail-3:7443",
    "repair_interval_seconds": 15
  },
  "tls": {
    "cert_file": "/etc/robinmail/secrets/tls.crt",
    "key_file": "/etc/robinmail/secrets/tls.key"
  },
  "smtp": {
    "listen": ":25",
    "max_connections": 1000,
    "max_connections_per_ip": 1000
  },
  "web": {
    "listen": ":443"
  }
}
