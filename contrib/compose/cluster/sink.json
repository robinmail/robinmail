{
  "hostname": "mail.sink.test",
  "data_dir": "/var/lib/robinmail",
  "master_key_file": "/etc/robinmail/secrets/master.key",
  "tls": {
    "cert_file": "/etc/robinmail/secrets/sink.crt",
    "key_file": "/etc/robinmail/secrets/sink.key"
  },
  "smtp": {
    "listen": ":25",
    "max_connections": 1000,
    "max_connections_per_ip": 1000,
    "max_bytes_in_transit": 536870912,
    "max_bytes_in_transit_per_ip": 536870912
  },
  "web": {
    "listen": ":443",
    "max_connections": 10000,
    "max_connections_per_ip": 10000
  },
  "submission": {
    "undo_seconds": 0
  },
  "outbound": {
    "routes": {"cluster.test": "robinmail-1:25"}
  }
}
