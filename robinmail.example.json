{
  "hostname": "mail.example.test",
  "data_dir": "data",
  "master_key_file": "master.key",
  "rqlite": {
    "url": "http://127.0.0.1:4001",
    "urls": []
  },
  "node": {
    "id": "",
    "listen": "",
    "address": "",
    "blob_copies": 0,
    "repair_interval_seconds": 0
  },
  "tls": {
    "cert_file": "/etc/robinmail/fullchain.pem",
    "key_file": "/etc/robinmail/privkey.pem",
    "acme": false,
    "acme_email": ""
  },
  "smtp": {
    "listen": ":25",
    "max_message_bytes": 26214400,
    "max_recipients": 100,
    "max_connections": 100,
    "max_connections_per_ip": 10
  },
  "web": {
    "listen": ":443",
    "http_listen": "",
    "dev_origins": []
  },
  "rspamd": {
    "url": "http://127.0.0.1:11333",
    "fail_open": false,
    "timeout_seconds": 30
  },
  "submission": {
    "listen": ":587",
    "listen_tls": ":465",
    "max_recipients_per_hour": 300,
    "undo_seconds": 10
  },
  "imap": {
    "listen_tls": ":993",
    "listen": "",
    "max_connections": 1000,
    "max_connections_per_ip": 20,
    "max_connections_per_user": 20
  },
  "outbound": {
    "concurrency": 8,
    "per_destination": 2,
    "routes": {}
  },
  "auth": {
    "require_app_passwords": false,
    "audit_retention_days": 90,
    "oidc": []
  },
  "quota": {
    "default_bytes": 0,
    "default_messages": 0
  }
}
